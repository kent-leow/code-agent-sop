# ─────────────────────────────────────────────────────────────
# Copilot Agent SOP — Credential Template
#
# Copy values into ~/.zshenv (do NOT commit real values):
#   cp .env.example ~/.zshenv.sop && cat ~/.zshenv.sop >> ~/.zshenv
# ─────────────────────────────────────────────────────────────

# ── Jira (skill: jira-ticket) ─────────────────────────────────
# API token from https://id.atlassian.com/manage-profile/security/api-tokens
export JIRA_TOKEN=your-jira-api-token

# Your Atlassian account email
export JIRA_EMAIL=your-email@example.com

# Base URL of your Jira instance
export JIRA_BASE_URL=https://your-org.atlassian.net

# Project key (e.g. PROJ, GOBIZ)
export JIRA_PROJECT_KEY=PROJ

# ── Figma (skill: figma-design-context) ───────────────────────
# Personal access token from https://www.figma.com/settings → Personal access tokens
export FIGMA_TOKEN=your-figma-personal-access-token

# ── GitLab (skills: git-apis, git-workflow, gitlab-mr-automation, fix-vulnerabilities, env-chope) ──
# Personal access token (scopes: api, read_api) from GitLab → Preferences → Access Tokens
export GITLAB_TOKEN=your-gitlab-personal-access-token

# ── APEX logs (skill: investigate-apex) ───────────────────────
# Elastic API keys for APEX gateway log clusters
export APEX_LOG_TOKEN_STAGING=your-apex-staging-api-key
export APEX_LOG_TOKEN_PROD=your-apex-prod-api-key

# ── OpenSearch (skill: opensearch-logs, agent: investigate) ───
# No auth — connect to VPN first. dev/qa/staging share the NONPROD cluster.
# Dashboards UI = <url>/_dashboards
export OPENSEARCH_URL_NONPROD=https://vpc-staging-u5zne67sofr6wcvcevees6ebre.ap-southeast-1.es.amazonaws.com
export OPENSEARCH_URL_PROD=https://opensearch.molbproject.io

# ── PostgreSQL (skill: postgres-query, agent: investigate) ────
# Values from DBeaver: Host / Port / Database / Username / Password / session role.
# VPN required. DEV/QA/STG = read+write (writes need explicit approval); PROD = read-only.
# Single-quote values with special characters, e.g. export X='p@ss$word'
# Pattern: DB_<LICENCE|AGENCY_PORTAL|FORMBUILDER|ONBOARDING_PORTAL|PAYMENT>_<DEV|QA|STG|PROD>_<FIELD>

# Licence service
export DB_LICENCE_DEV_HOST=your-host
export DB_LICENCE_DEV_PORT=5432
export DB_LICENCE_DEV_NAME=your-database
export DB_LICENCE_DEV_USER=your-username
export DB_LICENCE_DEV_PASSWORD=your-password
export DB_LICENCE_DEV_ROLE=your-session-role
export DB_LICENCE_QA_HOST=your-host
export DB_LICENCE_QA_PORT=5432
export DB_LICENCE_QA_NAME=your-database
export DB_LICENCE_QA_USER=your-username
export DB_LICENCE_QA_PASSWORD=your-password
export DB_LICENCE_QA_ROLE=your-session-role
export DB_LICENCE_STG_HOST=your-host
export DB_LICENCE_STG_PORT=5432
export DB_LICENCE_STG_NAME=your-database
export DB_LICENCE_STG_USER=your-username
export DB_LICENCE_STG_PASSWORD=your-password
export DB_LICENCE_STG_ROLE=your-session-role
export DB_LICENCE_PROD_HOST=your-host
export DB_LICENCE_PROD_PORT=5432
export DB_LICENCE_PROD_NAME=your-database
export DB_LICENCE_PROD_USER=your-username
export DB_LICENCE_PROD_PASSWORD=your-password
export DB_LICENCE_PROD_ROLE=your-session-role

